# Supabase — service_role key (NOT anon key). See README for steps.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=

# Odds (required for live data)
SHARPAPI_KEY=

# Context signals (recommended)
API_SPORTS_KEY=
GNEWS_API_KEY=

# AI — pick ONE (OpenAI preferred; ChatGPT Plus ≠ API access)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=

# App
CORS_ORIGINS=http://localhost:3000
USE_DEMO_DATA=false
