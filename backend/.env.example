# ============================================================================
# Prediction Parlay — backend environment
# The app runs FULLY FREE with ZERO keys: ESPN (odds, scores, injuries, news)
# and Open-Meteo (weather) need no key. Add the optional keys below to unlock
# the independent AI research pass and player props.
# ============================================================================

# --- Storage (optional but recommended for tracking + line history) ---------
# Supabase project URL + the service_role key (NOT the anon key).
# Get them: https://supabase.com -> your project -> Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=

# --- AI research + chat (HIGHLY recommended — this is what makes picks smart)-
# Gemini is free: 1,500 requests/day on the free tier.
# Get a key: https://aistudio.google.com/app/apikey
# Note: free-tier quota lives on the current-gen models. gemini-2.5-flash-lite
# is free and fast; older gemini-2.0-flash now returns limit:0 on free keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# Optional paid fallback only. Leave blank to stay 100% free.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Player props (NBA) -----------------------------------------------------
# BallDontLie free tier gives NBA season averages used for prop projections.
# Get a key: https://app.balldontlie.io/  (Account -> API Key)
BALLDONTLIE_API_KEY=
ENABLE_PLAYER_PROPS=true

# --- Odds source ------------------------------------------------------------
# Default is ESPN (free, no key). Add a key below ONLY for richer multi-book
# lines. The Odds API free tier is 500 credits/month — keep ODDS_SYNC_MINUTES
# high (>=30) if you use it. Get a key: https://the-odds-api.com/
ODDS_API_KEY=
# Legacy paid aggregator (SharpAPI). Leave blank unless you already pay for it.
SHARPAPI_KEY=

# --- Legacy / optional score fallback ---------------------------------------
# ESPN now covers scores + injuries for free; these are no longer needed.
# API_SPORTS_KEY=        # optional fallback score source only
# GNEWS_API_KEY=         # deprecated — ESPN news replaces it

# --- Tuning -----------------------------------------------------------------
ODDS_SYNC_MINUTES=15        # how often to refresh odds (raise to 30+ for Odds API)
RESEARCH_TTL_MINUTES=30     # cache window for the Gemini research pass per game

# --- App --------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
USE_DEMO_DATA=false
